;problem for:
;If there are no transporters, the drone is able to carry individual boxes.
;If, after using the transporter, there are still some loose boxes left, the drone is able to pick them up
(defproblem prob-no-carriers p3
  (
    (drone-at drone1 depot)
    (empty-arm drone1 arm1)

    (crates-at food depot 5)
    (needs food loc1 2)
  )
  (
    (deliver-all)
  )
)

;problem for:
;If the transporter is smaller than the need, it loads to maximum capacity.
;If the transporter is larger than the need, it loads partially.
;If there are several transporters several fit, smallest is chosen.
;If there are several transporters all too small, largest is chosen.
;Every time the drone returns to the depot, it chooses next transporter based on updated needs.

;Serves first those with the greatest need.

(defproblem problem p3
  (
    (drone-at drone1 depot)
    (carrier-at carrier1 depot)

    (carrier-capacity carrier1 10)
    (carrier-total-load carrier1 0)

    (carrier-content carrier1 food 0)
    (carrier-content carrier1 medicine 0)

    (crates-at food depot 21) 
    (crates-at medicine depot 20)

    (needs food loc1 6)
    (needs medicine loc1 3)
    (needs food loc2 15)
  )
  (
    (deliver-all)
  )
)


;problem for:
