(defdomain p2
  (
    (:- (same ?x ?x) nil)
    (:- (has-needs) ((needs ?type ?loc ?count) (call >= ?count 1)))

    (:- (smaller-fitting-transporter-exists ?need ?cap)
        ((transporter-at ?t depot) (transporter-capacity ?t ?c) (call >= ?c ?need) (call < ?c ?cap)))

    (:- (any-transporter-fits ?need)
        ((transporter-at ?t depot) (transporter-capacity ?t ?c) (call >= ?c ?need)))

    (:- (larger-transporter-exists ?cap)
        ((transporter-at ?t depot) (transporter-capacity ?t ?c) (call > ?c ?cap)))

    (:- (greater-need-exists ?count)
        ((needs ?t ?l ?n) (call > ?n ?count)))


    (:operator (!pick-up-single-box ?type ?location ?drone ?arm)
       ((drone-at ?drone ?location) (empty-arm ?drone ?arm) (boxes-at ?type ?location ?count) (call >= ?count 1))
       ((boxes-at ?type ?location ?count) (empty-arm ?drone ?arm))
       ((boxes-at ?type ?location (call - ?count 1)) (has-single-drone-arm ?drone ?arm ?type))
    )

    (:operator (!drone-move ?location_from ?location_to ?drone)
      ((drone-at ?drone ?location_from))
      ((drone-at ?drone ?location_from))
      ((drone-at ?drone ?location_to))
      50
    )

    (:operator (!drop-single ?location ?type ?arm ?drone)
      ((drone-at ?drone ?location) (needs ?type ?location ?need-count) (has-single-drone-arm ?drone ?arm ?type) (call >= ?need-count 1))
       ((has-single-drone-arm ?drone ?arm ?type) (needs ?type ?location ?need-count))
       ((needs ?type ?location (call - ?need-count 1)) (empty-arm ?drone ?arm))
    )

    (:operator (!load-transporter ?transporter ?type ?quantity ?location ?drone)
      ((drone-at ?drone ?location)
       (boxes-at ?type ?location ?available)
       (call >= ?available ?quantity)
       (transporter-capacity ?transporter ?cap)
       (transporter-total-load ?transporter ?current-total) 
       (call <= (call + ?current-total ?quantity) ?cap)
       (transporter-content ?transporter ?type ?current-type-count))
      ((boxes-at ?type ?location ?available)
       (transporter-content ?transporter ?type ?current-type-count)
       (transporter-total-load ?transporter ?current-total))
      ((boxes-at ?type ?location (call - ?available ?quantity))
       (transporter-content ?transporter ?type (call + ?current-type-count ?quantity))
       (transporter-total-load ?transporter (call + ?current-total ?quantity)))
    )

    (:operator (!reserve-delivery ?transporter ?type ?location ?quantity)
      ((needs ?type ?location ?need-count) (call >= ?need-count ?quantity))
      ((needs ?type ?location ?need-count))
      ((needs ?type ?location (call - ?need-count ?quantity))
       (reserved ?transporter ?type ?location ?quantity))
    )

    (:operator (!unload-transporter ?transporter ?type ?quantity ?location ?drone)
      ((drone-at ?drone ?location)
       (transporter-at ?transporter ?location)
       (transporter-content ?transporter ?type ?current-type-count)
       (call >= ?current-type-count ?quantity)
       (transporter-total-load ?transporter ?current-total)
       (reserved ?transporter ?type ?location ?quantity))

      ((transporter-content ?transporter ?type ?current-type-count)
       (transporter-total-load ?transporter ?current-total)
       (reserved ?transporter ?type ?location ?quantity))

      ((transporter-content ?transporter ?type (call - ?current-type-count ?quantity))
       (transporter-total-load ?transporter (call - ?current-total ?quantity)))
    )

    (:operator (!drone-move-transporter ?location_from ?location_to ?drone ?transporter)
      ((drone-at ?drone ?location_from)
       (transporter-at ?transporter ?location_from)
       (transporter-capacity ?transporter ?cap))
      ((drone-at ?drone ?location_from)
       (transporter-at ?transporter ?location_from))
      ((drone-at ?drone ?location_to)
       (transporter-at ?transporter ?location_to))
      (call + 50 (call / ?cap 10))
    )

    (:method (move-drone-alone ?drone ?loc-to)
      already-there
      ((drone-at ?drone ?loc-to))
      ()
      need-to-move
      ((drone-at ?drone ?loc-from) (not (same ?loc-from ?loc-to)))
      ((!drone-move ?loc-from ?loc-to ?drone))
    )

    (:method (move-drone-transporter ?drone ?transporter ?loc-to)
      already-there
      ((drone-at ?drone ?loc-to))
      ()
      need-to-move
      ((drone-at ?drone ?loc-from) (not (same ?loc-from ?loc-to)))
      ((!drone-move-transporter ?loc-from ?loc-to ?drone ?transporter))
    )


    (:method (deliver-all)
      finish-delivery
      (not (has-needs))
      ()

      use-transporter-smallest-fits
      (
        (needs ?type ?loc ?need-count)
        (call >= ?need-count 1)
        (not (greater-need-exists ?need-count))

        (transporter-at ?transporter depot)
        (transporter-capacity ?transporter ?cap)
        (call >= ?cap ?need-count)
        (not (smaller-fitting-transporter-exists ?need-count ?cap))
      )
      (
        (move-drone-alone drone1 depot)
        (fill-transporter ?transporter drone1)
        (dispatch-transporter ?transporter drone1)
        (deliver-all)
      )

      use-transporter-largest-no-fit
      (
        (needs ?type ?loc ?need-count)
        (call >= ?need-count 1)
        (not (greater-need-exists ?need-count))

        (transporter-at ?transporter depot)
        (transporter-capacity ?transporter ?cap)
        (not (any-transporter-fits ?need-count))
        (not (larger-transporter-exists ?cap))
      )
      (
        (move-drone-alone drone1 depot)
        (fill-transporter ?transporter drone1)
        (dispatch-transporter ?transporter drone1)
        (deliver-all)
      )


      fallback-single-box
      (
        (needs ?type ?loc ?need-count) 
        (call >= ?need-count 1)
        (empty-arm ?drone ?arm)
      )
      (
        (move-drone-alone ?drone depot)
        (!pick-up-single-box ?type depot ?drone ?arm)
        (move-drone-alone ?drone ?loc)
        (!drop-single ?loc ?type ?arm ?drone)
        (deliver-all) 
      )
    )

    (:method (fill-transporter ?transporter ?drone)
      full
      (
        (transporter-capacity ?transporter ?cap)
        (transporter-total-load ?transporter ?load)
        (call = ?cap ?load)
      )
      ()

      load-fits
      (
        (needs ?type ?loc ?need)
        (call >= ?need 1)
        (transporter-capacity ?transporter ?cap)
        (transporter-total-load ?transporter ?load)
        (call <= (call + ?load ?need) ?cap)
      )
      (
        (!reserve-delivery ?transporter ?type ?loc ?need)
        (!load-transporter ?transporter ?type ?need depot ?drone)
        (fill-transporter ?transporter ?drone)
      )

      load-partial
      (
        (needs ?type ?loc ?need)
        (call >= ?need 1)
        (transporter-capacity ?transporter ?cap)
        (transporter-total-load ?transporter ?load)
        (call > (call + ?load ?need) ?cap)
        (call > (call - ?cap ?load) 0)
      )
      (
        (!reserve-delivery ?transporter ?type ?loc (call - ?cap ?load))
        (!load-transporter ?transporter ?type (call - ?cap ?load) depot ?drone)
        (fill-transporter ?transporter ?drone)
      )

      no-more-needs
      (not (has-needs))
      ()
    )

    (:method (dispatch-transporter ?transporter ?drone)
      deliver-next
      (
        (reserved ?transporter ?type ?loc ?quantity)
      )
      (
        (move-drone-transporter ?drone ?transporter ?loc)
        (!unload-transporter ?transporter ?type ?quantity ?loc ?drone)
        (dispatch-transporter ?transporter ?drone)
      )

      all-delivered
      (
        (not (reserved ?transporter ?any-type ?any-loc ?any-quantity))
      )
      (
        (move-drone-transporter ?drone ?transporter depot)
      )
    )
  )
)